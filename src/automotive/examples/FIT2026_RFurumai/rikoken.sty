%\@numsauthorの値に応じて，"<author1>, <author2>, ... and <author 6> を制御
%4人以下なら1行に，5人以上なら4人目以降を2行目に出力
\def\and@for#1{%
	\@tempcnta=\@numsauthor%
	\@tempcntb=\z@%
	\@for\member:=#1\do{%
	\ifnum\@numsauthor=4%
		\ifnum\@tempcnta>2\relax%
			\member,\hspace{-0.3em}
		\else
			\ifnum\@tempcnta=2\relax%
				\member\space
			\else
				\ifnum\@tempcnta=1\relax%
					and\space\hspace{-0.4em}\member\\
				\fi
			\fi
		\fi
	\else
	\ifnum\@numsauthor=1\relax%
		\ifnum\@tempcnta=1\relax%
			\member\\
		\fi
	\else
		\ifnum\@tempcnta>2\relax%
			\member,\hspace{-0.3em}
		\else
			\ifnum\@tempcnta=2\relax%
				\member\space
			\else
				\ifnum\@tempcnta=1\relax%
					and\space\hspace{-0.4em}\member\\
				\fi
			\fi
		\fi
		\ifnum\@numsauthor>4\relax%
			\ifnum \@tempcntb=2\relax%
				\linebreak
			\fi
		\fi
	\fi
	\fi
	\advance \@tempcntb \@ne%カウンタをインクリメント
	\advance\@tempcnta\m@ne%カウンタをデクリメント
	}
}
\let\printauthors\and@for


%4人以下なら1行に，5人以上なら4人目以降を2行目に出力
\def\jand@for#1{%
	\@tempcnta=\@jnumsauthor%
	\@tempcntb=\z@%
	\@for\member:=#1\do{%
		\ifnum\@jnumsauthor=4%
			\ifnum\@tempcnta>1\relax%
				\ifnum\@tempcntb=0\relax%
					\\\vspace{10pt}\member\hspace{2zw}
				\else
					\member\hspace{2zw}
				\fi
			\else
				\ifnum\@tempcnta=1\relax%
					\member
				\fi
			\fi
		\else
			\ifnum\@jnumsauthor=1%
				\ifnum\@tempcntb=0\relax%
					\\\vspace{10pt}\member
				\fi
			\else
				\ifnum\@tempcnta>1\relax%
					\ifnum\@tempcntb=0\relax%
						\\\vspace{10pt}\member\hspace{2zw}
					\else
						\ifnum\@tempcntb=2\relax%
							\member\\
						\else
							\member\hspace{2zw}
						\fi
					\fi
				\else
					\ifnum\@tempcnta=1\relax%
						\member
					\fi
				\fi
			\fi
		\fi
	\advance\@tempcnta\m@ne%カウンタをデクリメント
	\advance \@tempcntb \@ne%カウンタをインクリメント
	}
}
\let\jprintauthors\jand@for


\renewcommand\maketitle{
	\twocolumn[
	\begin{center}
		\setlength{\baselineskip}{24pt}
		\textbf{{\Large {\@title}}}
		\\\vspace{3mm}
		\printauthors{\@firstauthor, \@secondauthor, \@thirdauthor,
		\@fourthauthor, \@fifthauthor, \@sixthauthor}
		\vspace{3mm}(Received \@date)
		\\\vspace{7mm}
		\begin{minipage}{16cm}
		\setlength{\parindent}{7mm}%
		\setlength{\baselineskip}{15pt}
		{\small
		\@abstract
		\\\\
		\@keywords
		\@jkeywords
		}
		\end{minipage}
		\setlength{\baselineskip}{24pt}
		\textmc{{\Large {\@jtitle}}}
		\jprintauthors{\@jfirstauthor, \@jsecondauthor, \@jthirdauthor,
		\@jfourthauthor, \@jfifthauthor, \@jsixthauthor}
		\\\vspace{13mm}
		\end{center}%
	]
}


