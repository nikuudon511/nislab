\def\brl{\\\hspace{3.4mm} }
\def\brr{\\\hspace{88.6mm}}

\def\initializeaffiliation{
	\gdef\@numsaffiliation{0}
}

\def\affitem#1#2{
\ifnum#1=1
	\hspace{2mm}* #2\\
	\gdef\@numsaffiliation{10}
\else
	\ifnum#1=2
		\vspace{-16.7mm}
		\hspace{85mm}** #2\\
		\gdef\@numsaffiliation{17}
	\else
		\ifnum#1=3
			\hspace{0.5mm}*** #2\\
		\else
			\ifnum#1=4
				\hspace{0.5mm}**** #2\\
			\fi
		\fi
	\fi
\fi
}

