<routes>
    <vType id="car_freeflow" carFollowModel="Krauss" maxSpeed="27.78" accel="2.6" decel="4.5" sigma="0.5" length="5" minGap="2.5" tau="1.0"/>
    
    <route id="route0" edges="mainline bottleneck"/>
    
    <!-- Staged highway demand: start sparse, then raise density step by step. A downstream bottleneck in the net file turns the high-demand tail into an on-road queue. -->
    <flow id="flow_low" type="car_freeflow" route="route0" begin="0" end="30" vehsPerHour="600" departLane="best" departSpeed="max"/>
    <flow id="flow_moderate" type="car_freeflow" route="route0" begin="30" end="70" vehsPerHour="1800" departLane="best" departSpeed="max"/>
    <flow id="flow_busy" type="car_freeflow" route="route0" begin="70" end="110" vehsPerHour="3600" departLane="best" departSpeed="max"/>
    <flow id="flow_dense" type="car_freeflow" route="route0" begin="110" end="150" vehsPerHour="7200" departLane="best" departSpeed="max"/>
    <flow id="flow_stress" type="car_freeflow" route="route0" begin="150" end="240" vehsPerHour="14400" departLane="best" departSpeed="max"/>
</routes>
